{
  "name": "core-workersai-proxy",
  "main": "dist/_worker.js/index.js",
  "compatibility_date": "2026-05-25",
  "compatibility_flags": ["nodejs_compat"],
  "upload_source_maps": true,
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true,
    },
    "traces": {
      "enabled": true,
      "persist": true,
      "head_sampling_rate": 1,
    },
  },
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true,
    "not_found_handling": "404-page",
  },
  "ai": {
    "binding": "AI",
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "CODE_MODE_AGENT",
        "class_name": "CodeModeAgent",
      },
      {
        "name": "BROWSER_HITL_AGENT",
        "class_name": "BrowserHitlAgent",
      },
      {
        "name": "WORKFLOWS_AGENT",
        "class_name": "WorkflowsAgent",
      },
      {
        "name": "ARTIFACT_AGENT",
        "class_name": "ArtifactAgent",
      },
      {
        "name": "CHAT_BROKER",
        "class_name": "ChatBroker",
      },
      {
        "name": "NOTIFICATIONS_AGENT",
        "class_name": "NotificationsAgent",
      },
    ],
  },
  "worker_loaders": [
    { "binding": "WORKER_LOADERS" }
  ],
  "migrations": [
    // v1 captures the original deployed-class set so wrangler can apply
    // an additive history. Do NOT rewrite this tag — it is immutable
    // once a Worker has shipped under it.
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "OrchestratorAgent",
        "CodeModeAgent",
        "GoogleDocsAgent",
        "BrowserHitlAgent",
        "WorkflowsAgent",
        "ArtifactAgent",
      ],
    },
    // v2 brings the live Worker in line with the lean template:
    //   - retire OrchestratorAgent + GoogleDocsAgent (no longer exported)
    //   - introduce ChatBroker (assistant-ui WebSocket broker)
    //   - introduce NotificationsAgent (per-session realtime fanout)
    {
      "tag": "v2",
      "deleted_classes": ["OrchestratorAgent", "GoogleDocsAgent"],
      "new_sqlite_classes": ["ChatBroker", "NotificationsAgent"],
    },
  ],
  "vars": {
    "AI_GATEWAY_ID": "default-gateway",
    "MODEL_CHAT": "@cf/openai/gpt-oss-120b",
    "MODEL_EXTRACT": "@cf/openai/gpt-oss-120b",
    "MODEL_DRAFT": "@cf/openai/gpt-oss-120b",
    "MODEL_TRANSCRIBE": "@cf/openai/whisper-large-v3-turbo",
    "DEFAULT_MODEL_EMBEDDING": "@cf/baai/bge-large-en-v1.5",
  },
  "kv_namespaces": [
    {
      "binding": "SESSIONS",
      "id": "aba8552a49c64335ba4832d34ce9459d",
      "remote": true,
    },
  ],
  // This Worker MUST create its own D1 database. These two values are deliberately
  // NOT a real database, so `wrangler deploy` and `wrangler d1 migrations apply`
  // both fail until someone replaces them. That failure is the feature.
  //
  // MEASURED 2026-11-02, and the reason this is a placeholder rather than a real
  // id: `database_id` here held d555f8ce-77c9-4c82-be80-de95b8d9c003, which is
  // core-guardian's PRODUCTION database. core-guardian is the account's spend
  // governor: it watches the Cloudflare bill and holds the switches that shut
  // services down.
  //
  // The D1 API resolves that uuid to name "core-template-cfw-assets-astro-shadcn",
  // num_tables 123, file_size 400,293,888 bytes (400.3 MB). A template created the
  // database and core-guardian adopted it, so Cloudflare still lists the template's
  // name. The uuid reached this repo from that same template.
  //
  // `database_name` above said "core-workersai-proxy", which is cosmetic: only the
  // uuid binds. A server-side code search for this uuid over default branches
  // returned 13 files on 2026-11-02, so 13 configs bound one database while each
  // claimed a name of its own.
  //
  // The Worker `core-workersai-proxy` still exists on the account, but its DEPLOYED
  // version carries no D1 binding at all (measured 2026-11-02 against the Workers
  // settings API). So the risk here is not the running Worker. It is the next `pnpm
  // run deploy` from this repo, which would bind guardian's database again and run
  // this repo's Drizzle migrations against it.
  //
  // To set this project up:
  //   npx wrangler d1 create core-workersai-proxy
  //   # put the returned name and uuid below, then:
  //   npx wrangler d1 migrations apply DB --remote
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "REPLACE_WITH_YOUR_OWN_D1_DATABASE",
      "database_id": "replace-me-run-wrangler-d1-create",
      "migrations_dir": "drizzle",
    },
  ],
  "secrets_store_secrets": [
    {
      "binding": "GITHUB_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GH_TOKEN",
    },
    {
      "binding": "CLOUDFLARE_ACCOUNT_ID",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_ACCOUNT_ID",
    },
    {
      "binding": "CLOUDFLARE_WRANGLER_API_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_WRANGLER_API_TOKEN",
    },
    {
      "binding": "WORKER_API_KEY",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "WORKER_API_KEY",
    },
    {
      "binding": "AI_GATEWAY_TOKEN",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "CLOUDFLARE_AI_GATEWAY_TOKEN",
    },
    {
      "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_1",
    },
    {
      "binding": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_PRIVATE_KEY_PT_2",
    },
    {
      "binding": "GOOGLE_CREDS_SA_CLIENT_EMAIL",
      "store_id": "8c42fa70938644e0a8a109744467375f",
      "secret_name": "GOOGLE_CREDS_SA_CLIENT_EMAIL",
    },
  ],
  //  wrangler vectorize create core-workersai-proxy-career-memory --preset @cf/baai/bge-large-en-v1.5
  "vectorize": [
    {
      "binding": "VECTORIZE_CAREER_MEMORY",
      "index_name": "core-workersai-proxy-career-memory",
      "remote": true,
    },
  ],
  "r2_buckets": [
    {
      "binding": "R2_AUDIO_BUCKET",
      "bucket_name": "core-workersai-proxy-audio",
      "remote": true,
    },
    {
      "bucket_name": "core-workersai-proxy-files",
      "binding": "R2_FILES_BUCKET",
      "remote": true,
    },
  ],
}
